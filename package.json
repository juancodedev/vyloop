{
  "name": "vyloop",
  "private": true,
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "format:fix": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "wallet:readiness": "node scripts/check-wallet-readiness.mjs",
    "wallet:inactivity:dry-run": "pnpm --filter @vyloop/db exec tsx ../../scripts/pass-inactivity-dry-run.mjs",
    "db:drift": "node scripts/check-migration-drift.mjs",
    "db:drift:baseline": "node scripts/check-migration-drift.mjs --check-baseline",
    "db:checkin-backlog": "node scripts/check-checkin-backlog.mjs",
    "db:payment-reconciliation": "node scripts/check-payment-reconciliation.mjs",
    "deps:overrides": "node scripts/check-dependency-overrides.mjs",
    "deps:audit": "node scripts/check-audit.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.6.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.31.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.3",
    "vite": "^8.3.4"
  },
  "pnpm": {
    "overrides": {
      "esbuild@<=0.24.2": ">=0.25.0",
      "cookie@<0.7.0": ">=0.7.0",
      "ws@>=8.0.0 <8.21.0": ">=8.21.0",
      "undici@<6.27.0": ">=6.27.0",
      "react": "19.3.1",
      "react-dom": "19.3.1",
      "brace-expansion@<1.1.18": ">=1.1.18",
      "nanoid@<3.3.18": ">=3.3.18",
      "sharp@<0.35.4": ">=0.35.4",
      "undici@>=7.28.0 <7.29.1": ">=7.29.1",
      "fast-uri@>=3.0.0 <3.1.7": ">=3.1.7",
      "jsdom>undici": "^7.25.0"
    }
  }
}
