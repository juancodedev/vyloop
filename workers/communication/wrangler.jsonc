{
  "name": "communication",
  "main": "./src/index.ts",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "WHATSAPP_API_VERSION": "v21.0"
  },
  "kv_namespaces": [
    {
      "binding": "SCHEMA_REGISTRY",
      "id": "732ccde5b0944db082d07667aba8104b"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "DELIVERY_QUEUE",
        "queue": "vyloop-notification-deliveries"
      }
    ],
    "consumers": [
      {
        "queue": "vyloop-notification-deliveries",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3
      }
    ]
  }
,
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}