{
  "name": "wallet",
  "main": "./src/index.ts",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],
  // Secrets are never in this file. Every GOOGLE_WALLET_* value and
  // MEMBER_CODE_PEPPER arrives through `wrangler secret put`.
  "vars": {
    "GOOGLE_WALLET_ISSUER_ID": "3388000000023206930",
    // Google refuses to issue a save link without an allow-list of origins, and
    // names it in the error rather than in the docs, so the first mint in a fresh
    // environment fails with `WALLET_NOT_CONFIGURED`. Both surfaces that can
    // offer a pass are listed: the customer web, and the operator console on the
    // dashboard. Comma-separated, no trailing slash, and the value is compared
    // against the request's own `Origin`.
    "WALLET_ALLOWED_ORIGINS": "https://vyloop-customer-web.pages.dev,https://vyloop.juancode.dev",
    // Not a secret, and not a fact we can read from Google. Google's publishing
    // approval is a single grant for the whole issuer account and this
    // deployment has not been granted it, so passes minted here only reach the
    // issuer's own test accounts. Flipping this to "false" is what an
    // environment with publishing access declares. See `parseDemoMode`, which
    // treats anything unrecognised as demo mode on purpose.
    "WALLET_DEMO_MODE": "true",
    // THREE base URLs, and they have three distinct consumers. Collapsing them
    // reintroduces a class-rejection bug — Google fetches `programLogo` from
    // MEDIA, opens `homepageUri` from WEB during class review, and the pass's
    // links come from CUSTOMER_WEB. One shared var built `homepageUri` from the
    // media host once already, and `media.juancode.dev/program` answered 404:
    // docs/11 records that 404 as the most common class rejection reason, so
    // every class provisioned under it was one Google would refuse.
    //
    // MEDIA and WEB now hold the SAME host, because the program page moved onto
    // the gateway. They stay separate vars because either may have to move
    // without the other: the logo and the homepage are different fields with
    // different histories, and one shared var is exactly how they got crossed
    // before. If you are tempted to merge them, read `provision.ts` first.
    //
    // MEDIA is the gateway, because the brand route under it is the only public
    // door to a private R2 bucket, and it answers with the platform default logo
    // for a business that has uploaded none. Our own domain and not the r2.dev
    // preview URL — a class cannot be recreated under the same id, so losing that
    // subdomain would need a manual patch per class.
    //
    // All three are vars, not secrets: none is sensitive and all are read on
    // every class creation. No trailing slash — the parsers strip one, and a var
    // that carries one was pasted rather than written.
    "WALLET_MEDIA_BASE_URL": "https://media.juancode.dev",
    // The gateway, not the customer web. `homepageUri` points at the
    // per-merchant page the gateway renders server-side from
    // `loyalty_programs.promo_copy`, so it shares an origin with `/brand/*`.
    //
    // It USED to be the customer web, and the change is not cosmetic: Google's
    // reviewer opens this URL and reads the bytes. The customer web's own
    // `/program` served 5,917 characters of text, but the dashboard's page serves
    // 18 — it is a static export and every byte of content is fetched from the
    // client. A page a reviewer reads has to be in the HTML that arrives.
    //
    // **This domain is one-way.** Google's loyalty class review is not
    // repeatable: once a class is submitted, moving this host puts the class
    // back under review, and there is no path from a reviewed class back to
    // `draft` — the state transition out of draft is irreversible. So a host
    // chosen here cannot be changed after the first class is approved, and a
    // change made later is not a config edit, it is a re-review of every class
    // pointing at the old one. Decide the host before submitting the first
    // class. See `provision.ts`, where `homepageUri` is assembled.
    "WALLET_WEB_BASE_URL": "https://media.juancode.dev",

    // A THIRD host, and it is not the one above. The pass's links point at
    // `/profile` and `/profile/history`, which are `apps/customer-web` routes.
    // Building them from the gateway origin makes every link on every pass a
    // 404 — the `homepageUri` defect at a different URL, where nothing errors
    // and the link is simply a lie.
    "WALLET_CUSTOMER_WEB_BASE_URL": "https://vyloop-customer-web.pages.dev"
  },
  // No cron trigger here on purpose.
  //
  // The account allows five cron triggers and already uses all five, so a sixth
  // is rejected outright (Cloudflare error 10072) and fails the deploy. This
  // worker's sweep wants the same `0 6 * * *` that `workers/automation` already
  // holds, so `automation` keeps the single trigger and calls the `scheduled`
  // export below over a service binding — which also means the sweep runs with
  // this worker's own bindings and secrets, not forwarded ones.
  //
  // Adding a cron to this file will fail CI. That is the intended behaviour, not
  // a bug to work around: it means the account needs a plan that has room.
}
