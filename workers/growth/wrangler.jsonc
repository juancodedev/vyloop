{
  "name": "growth",
  "main": "./src/index.ts",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {},
  "kv_namespaces": [
    {
      "binding": "SCHEMA_REGISTRY",
      "id": "732ccde5b0944db082d07667aba8104b"
    }
  ],
  "queues": {
    "consumers": [
      {
        "queue": "vyloop-domain-events",
        "max_batch_size": 5,
        "max_batch_timeout": 5,
        "max_concurrency": 1
      }
    ],
    "producers": [
      {
        "binding": "DOMAIN_EVENTS_QUEUE",
        "queue": "vyloop-domain-events"
      },
      {
        // `CustomerCheckedIn` travels to the communication worker, the
        // delivery queue's one consumer.
        "binding": "DELIVERY_QUEUE",
        "queue": "vyloop-notification-deliveries"
      }
    ]
  },
  // The wallet, so a ledger write can ask for the balance projection at the
  // moment the balance moves. Growth publishes `PointsAssigned` and
  // `RewardRedeemed` already, and a queue consumer on the wallet was the
  // obvious way to consume them — but the wallet's config contract test forbids
  // a `queues` block there and the account's consumer limit is not verifiable
  // from this repository, so this binding is a direct RPC call under `waitUntil`
  // instead. See `schedulePassReconcile` for why the projection must not sit on
  // the response's critical path, and the feature's own notes for why a consumer
  // is still the better long-term shape if the account allows one.
  "services": [
    {
      "binding": "WALLET",
      "service": "wallet"
    }
  ]
,
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}