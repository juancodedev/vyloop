{
  "name": "identity",
  "main": "./src/index.ts",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "JWT_SECRET": "vyloop-dev-secret-2026",
    "DATABASE_URL": "postgresql://neondb_owner:REDACTED_NEON_PASSWORD@ep-shiny-paper-aibbf0hk-pooler.c-4.us-east-1.aws.neon.tech/neondb?sslmode=require"
  },
  "queues": {
    "consumers": [
      {
        "queue": "vyloop-events-dev",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "vyloop-events-dlq"
      }
    ]
  }
}
