{
  "name": "customer",
  "main": "./src/index.ts",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "DATABASE_URL": ""
  },
  "kv_namespaces": [
    {
      "binding": "SCHEMA_REGISTRY",
      "id": "schema-registry",
      "preview_id": "schema-registry-preview"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "DOMAIN_EVENTS_QUEUE",
        "queue": "vyloop-domain-events"
      }
    ]
  }
}
