{
  "name": "automation",
  "main": "./src/index.ts",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {},
  "kv_namespaces": [
    {
      "binding": "SCHEMA_REGISTRY",
      "id": "732ccde5b0944db082d07667aba8104b"
    }
  ],
    "queues": {
      "producers": [
        {
          "binding": "DOMAIN_EVENTS_QUEUE",
          "queue": "vyloop-domain-events"
        },
        {
          "binding": "DELIVERY_QUEUE",
          "queue": "vyloop-notification-deliveries"
        }
      ]
    },
    "services": [
      {
        "binding": "WALLET",
        "service": "wallet"
      },
      {
        "binding": "COMMUNICATION",
        "service": "communication"
      }
    ],
    "triggers": {
      "crons": ["0 6 * * *"]
    }
,
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}