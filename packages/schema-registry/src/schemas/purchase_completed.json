{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schema.vyloop.app/events/purchase_completed/v1",
  "title": "PurchaseCompleted",
  "description": "Emitted when a customer completes a purchase at the point of sale",
  "type": "object",
  "required": ["header", "payload"],
  "properties": {
    "header": {
      "type": "object",
      "required": ["event_id", "event_type", "event_version", "business_id", "timestamp"],
      "properties": {
        "event_id": {
          "type": "string",
          "format": "uuid",
          "description": "Unique identifier for this event instance"
        },
        "event_type": {
          "type": "string",
          "const": "purchase_completed",
          "description": "Event type discriminator"
        },
        "event_version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "description": "Semantic version of the event schema"
        },
        "business_id": {
          "type": "string",
          "format": "uuid",
          "description": "Tenant (business) identifier"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp of when the event occurred"
        }
      }
    },
    "payload": {
      "type": "object",
      "required": ["customer_id", "amount", "items"],
      "properties": {
        "customer_id": {
          "type": "string",
          "format": "uuid",
          "description": "The customer who made the purchase"
        },
        "branch_id": {
          "type": "string",
          "format": "uuid",
          "description": "The branch where the purchase occurred"
        },
        "amount": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Total purchase amount in the business's base currency"
        },
        "currency": {
          "type": "string",
          "minLength": 3,
          "maxLength": 3,
          "description": "ISO 4217 currency code"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "quantity", "unit_price"],
            "properties": {
              "sku": { "type": "string" },
              "name": { "type": "string" },
              "quantity": { "type": "integer", "minimum": 1 },
              "unit_price": { "type": "number", "exclusiveMinimum": 0 },
              "category": { "type": "string" }
            }
          }
        },
        "notes": {
          "type": "string",
          "description": "Optional notes attached to the purchase"
        }
      }
    }
  }
}
